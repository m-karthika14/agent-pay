# AgentPay environment variable template.
# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.
# See plan.md Section 6 for the authoritative list and Section 6 "Secret rules" for
# which values must never leave the backend.

# Application
APP_ENV=development
APP_NAME=AgentPay
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentpay

# Razorpay Test Mode
# NOT NEEDED until Phase 4 (Razorpay integration). Left blank until then.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxx

# LLM (Groq -- switched from Gemini after its API quota was persistently
# exhausted during development; the project's LLM calls are provider-agnostic
# via app/ai/llm_client.py).
# NOT NEEDED until Phase 6 (Merchant Revenue Agent) / Phase 7 (Intent Gate).
GROQ_API_KEY=xxxxxxxxxx
GROQ_MODEL=SET_CURRENT_SUPPORTED_MODEL

# MCP
# NOT NEEDED until Phase 5 (MCP + Claude).
MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_SERVER_NAME=AgentPay Merchant MCP

# Mandate signing
# Generated in Phase 1 (Security Foundation). Never commit real key material.
ED25519_PRIVATE_KEY_B64=xxxxxxxxxx
ED25519_PUBLIC_KEY_B64=xxxxxxxxxx

# Intent gate
# Frozen during Phase 7 calibration. Do not change after evaluation begins.
INTENT_CONFIDENCE_THRESHOLD=0.80

# Audit
AUDIT_HASH_ALGORITHM=sha256
