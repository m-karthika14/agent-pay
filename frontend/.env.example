# AgentPay frontend environment variables.
# Copy to `.env` for local development. Only public, non-secret values belong here —
# the Razorpay API secret and all backend-only secrets must never be exposed to the
# frontend (see plan.md Section 6 "Secret rules").

VITE_API_BASE_URL=http://localhost:8000

# NOT NEEDED until Phase 4 (Razorpay integration). This is the Razorpay *test* Key ID
# only — never the API secret.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
